# Local Docker dependencies (docker compose up -d)
DB_HOST=127.0.0.1
DB_USERNAME=muisnowdevs
DB_PASSWORD=muisnowdevs-local-password
DB_DATABASE=muisnowdevs

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-local-password
S3_PRIVATE_BUCKET=private
S3_PUBLIC_BUCKET=public
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
VITE_PUBLIC_URL=http://127.0.0.1:9000/public/

# Generate a distinct, high-entropy value for every non-local deployment.
VERIFICATION_KEY=replace-with-a-long-random-secret

# Required in production to protect /dashboard with Cloudflare Access.
CF_ACCESS_ORGANIZATION=
CF_ACCESS_AUD=
