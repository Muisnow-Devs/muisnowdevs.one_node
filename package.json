{
  "name": "muisnowdevs.one_node",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "test": "node --env-file=.env --import tsx --test \"app/**/*.test.ts\"",
    "typecheck": "react-router typegen && tsc",
    "start": "HOST=127.0.0.1 PORT=6158 react-router-serve ./build/server/index.js",
    "start:noenv": "react-router-serve ./build/server/index.js",
    "migrations:gen": "drizzle-kit generate",
    "migrations:gen-empty": "drizzle-kit generate --custom",
    "migrations:up": "drizzle-kit up",
    "migrations:apply": "tsx ./app/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@giscus/react": "^3.1.0",
    "@number-flow/react": "^0.6.2",
    "@react-router/fs-routes": "7.18.1",
    "@react-router/node": "7.18.1",
    "@react-router/serve": "7.18.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@uiw/react-md-editor": "^4.1.1",
    "daisyui": "^5.6.18",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.1",
    "hash-wasm": "^4.12.0",
    "is-ip": "^5.0.1",
    "isbot": "^5.2.1",
    "mdast": "^3.0.0",
    "mysql2": "^3.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "7.18.1",
    "react-syntax-highlighter": "^16.1.1",
    "redis": "^6.1.0",
    "rehype-raw": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remix-utils": "^10.0.0",
    "tiny-invariant": "^1.3.3",
    "typewriter-effect": "^2.22.0",
    "unist-util-visit": "^5.1.0",
    "uuid": "^14.0.1"
